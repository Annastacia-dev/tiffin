# Copy to .env.local and fill in.

# --- NextAuth ---
# Your site URL (http://localhost:3000 locally, your domain in production)
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these emails can sign in (comma-separated). Keeps your AI credits yours.
ALLOWED_EMAILS=annetotoh@gmail.com

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=
# Service role key: server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
