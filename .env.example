# Copy to .env.local and fill in.

# --- NextAuth ---
# Your site URL (http://localhost:3000 locally, your domain in production)
NEXTAUTH_URL=http://localhost:3000
# A long random string. Windows PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# Emails that can sign in (comma-separated). If it's empty, nobody can sign in.
ALLOWED_EMAILS=annetotoh@gmail.com
# Name shown in the greeting
DISPLAY_NAME=Annastacia
# Your password, hashed. Create it with: npm run hash-password -- "your password"
PASSWORD_HASH=

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=
# Service role key: server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
