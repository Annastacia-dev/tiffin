# Copy to .env.local and fill in. These are server secrets only:
# your name, email and password live in the app (Settings > Profile).

# --- NextAuth ---
# Your site URL (http://localhost:3000 locally, your domain in production)
NEXTAUTH_URL=http://localhost:3000
# A long random string. Windows PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# --- Google sign-in (optional; leave blank to hide the button) ---
# console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Reminders (optional; notifications stay off without these) ---
# Create the keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# How push services can reach you: mailto:you@example.com or your https site URL
VAPID_SUBJECT=
# A long random string. The scheduler sends it to /api/cron/reminders
CRON_SECRET=

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=
# Service role key: server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Database migrations (Prisma) ---
# Supabase > Connect > Session pooler (or Direct connection). Not the transaction pooler on port 6543.
# Only the Prisma commands use this. The app itself connects with the Supabase keys above.
DATABASE_URL=
